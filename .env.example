# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=crawler_db
DB_USER=crawler_admin
DB_PASSWORD=0000

# Crawler Configuration
CRAWLER_BASE_URL=https://truyenqqno.com
